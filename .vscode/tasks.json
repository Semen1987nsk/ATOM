{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend",
      "type": "shell",
      "command": "cd '${workspaceFolder}\\backend' ; python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload",
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}\\backend",
        "env": { "DEBUG": "true" }
      }
    },
    {
      "label": "Run Frontend",
      "type": "shell",
      "command": "cd '${workspaceFolder}\\frontend' ; npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      }
    }
  ]
}
