#!/bin/sh
# Pre-push: последний REJECT гейта без записанного «решение_владельца» не
# отгружается вместе с новой работой. Логика — gate_guard.py, блок push-check.
# Нет python — молча пустить: падение проверялки не запирает работу.
command -v python >/dev/null 2>&1 || exit 0
exec python "$HOME/.claude/hooks/gate_guard.py" --push-check
