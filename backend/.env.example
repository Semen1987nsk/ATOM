# ================================
# OAuth Configuration
# ================================
# Для включения входа через OAuth провайдеров,
# установите соответствующие Client ID и Client Secret.
# Без этих переменных кнопки OAuth не будут отображаться.

# Google OAuth
# Получить на: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Яндекс OAuth  
# Получить на: https://oauth.yandex.ru/client/new
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Сбер ID OAuth
# Получить на: https://developers.sber.ru/
SBER_CLIENT_ID=
SBER_CLIENT_SECRET=

# Тинькофф ID OAuth
# Получить на: https://www.tinkoff.ru/business/open-api/
TINKOFF_CLIENT_ID=
TINKOFF_CLIENT_SECRET=

# ================================
# API Configuration
# ================================
# JWT Secret Key (обязательно установите свой!)
JWT_SECRET_KEY=your-super-secret-key-change-in-production

# Database (SQLite по умолчанию)
# DATABASE_URL=sqlite:///./atom.db
