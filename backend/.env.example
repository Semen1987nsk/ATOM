# ================================
# ATOM Backend Configuration
# ================================
# Copy this file to .env and fill in your values
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(64))"

# ================================
# Security (CRITICAL!)
# ================================
# JWT Secret Key - MUST be set in production!
SECRET_KEY=your-super-secret-key-generate-with-secrets-module

# JWT token expiration (in minutes, default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ================================
# OAuth Configuration
# ================================
# Для включения входа через OAuth провайдеров,
# установите соответствующие Client ID и Client Secret.
# Без этих переменных кнопки OAuth не будут отображаться.

# Google OAuth
# Получить на: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Яндекс OAuth  
# Получить на: https://oauth.yandex.ru/client/new
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Сбер ID OAuth
# Получить на: https://developers.sber.ru/
SBER_CLIENT_ID=
SBER_CLIENT_SECRET=

# Тинькофф ID OAuth
# Получить на: https://www.tinkoff.ru/business/open-api/
TINKOFF_CLIENT_ID=
TINKOFF_CLIENT_SECRET=

# ================================
# Database
# ================================
# SQLite (default, development)
DATABASE_URL=sqlite:///./atom.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/atom

# ================================
# AI Services
# ================================
OPENAI_API_KEY=

# ================================
# Redis (production, for OAuth states and rate limiting)
# ================================
# REDIS_URL=redis://localhost:6379/0

# ================================
# CORS Configuration
# ================================
# Comma-separated list of allowed origins, or * for all
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# CORS_ORIGIN_REGEX=https://.*\.yourdomain\.com

# ================================
# Logging
# ================================
LOG_LEVEL=INFO
