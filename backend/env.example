# Образец backend/.env. Скопировать в backend/.env (он в .gitignore) и заполнить.
# Порядок загрузки: переменные ОС > backend/.env.local (не в production) > backend/.env.
# Полный перечень с умолчаниями — backend/config.py.

# --- Обязательные в production (DEBUG=false); в dev допустимы пустыми ---
DEBUG=true
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# другой ключ, не равный SECRET_KEY
REFRESH_SECRET_KEY=
# AES-256-GCM для токенов брокера: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Потеря боевого ключа = токены в базе не расшифровать.
MASTER_KEY_B64=
MASTER_KEY_ID=1

# --- База и Redis (в docker-compose переопределяются) ---
# пусто = sqlite:///./atom.db
DATABASE_URL=
REDIS_URL=

# --- Cookies и CORS ---
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
CORS_ORIGINS=
PUBLIC_URL=http://localhost:3000

# --- T-Bank Invest ---
# prod | sandbox
TINKOFF_API_ENV=sandbox
BROKER_SYNC_V2_ENABLED=false
# PEM с Russian Trusted Root CA: scripts/build_grpc_ca_bundle.ps1
TINKOFF_GRPC_CA_BUNDLE=

# --- Почта (пусто = только лог) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Наблюдаемость (пусто = Sentry выключен) ---
SENTRY_DSN=
LOG_FORMAT_MODE=text
